{
  "name": "hydra-frontend",
  "private": true,
  "version": "4.32.107",
  "type": "module",
  "scripts": {
    "predev": "node scripts/check-monaco-dependency.mjs",
    "dev": "vite",
    "prebuild": "node scripts/check-monaco-dependency.mjs",
    "build": "tsc -b && vite build && npm run bundle:check",
    "lint": "eslint .",
    "test": "node scripts/hydra-test-runner.mjs full",
    "test:watch": "vitest",
    "preview": "vite preview",
    "test:fast": "node scripts/hydra-test-runner.mjs fast",
    "test:full": "node scripts/hydra-test-runner.mjs full",
    "test:deterministic": "node scripts/hydra-test-runner.mjs deterministic",
    "test:changed": "node scripts/hydra-test-runner.mjs fast --changed",
    "test:parallel": "node scripts/hydra-test-runner.mjs parallel",
    "test:update-site": "vitest run src/update-site-import-center src/metamodel-designer/MetamodelImportDialog.window.test.tsx",
    "bundle:check": "node scripts/check-bundle-budget.mjs",
    "test:bundle-budget": "vitest run scripts/check-bundle-budget.test.mjs",
    "a11y:check": "node scripts/check-accessibility.mjs",
    "css:check": "node scripts/check-css-budgets.mjs",
    "test:a11y:axe": "vitest run src/accessibility/axeAccessibility.test.tsx",
    "test:a11y:e2e": "playwright test",
    "test:a11y": "npm run test:a11y:axe && npm run test:a11y:e2e",
    "test:reported-v43230": "node scripts/run-v43230-reported-tests.mjs",
    "test:aggressive": "node scripts/hydra-aggressive-test-runner.mjs"
  },
  "dependencies": {
    "@xyflow/react": "^12.11.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "monaco-editor": "0.52.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.1",
    "vitest": "^5.0.5",
    "@playwright/test": "1.62.1",
    "axe-core": "4.12.1"
  }
}
