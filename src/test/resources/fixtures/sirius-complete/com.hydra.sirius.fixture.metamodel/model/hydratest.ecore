<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore"
    name="hydratest"
    nsURI="https://hydra.example/sirius/fixture/1.0"
    nsPrefix="hydratest">

  <eClassifiers xsi:type="ecore:EEnum" name="PortDirection">
    <eLiterals name="IN" value="0"/>
    <eLiterals name="OUT" value="1"/>
    <eLiterals name="INOUT" value="2"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="ConnectionKind">
    <eLiterals name="CONTROL" value="0"/>
    <eLiterals name="DATA" value="1"/>
    <eLiterals name="ERROR" value="2"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="DataStoreKind">
    <eLiterals name="DATABASE" value="0"/>
    <eLiterals name="FILE" value="1"/>
    <eLiterals name="QUEUE" value="2"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="NamedElement" abstract="true">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="description" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="Workflow" eSuperTypes="#//NamedElement">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="version" defaultValueLiteral="1.0" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="nodes" upperBound="-1" containment="true" eType="#//FlowNode"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="connections" upperBound="-1" containment="true" eType="#//Connection"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="groups" upperBound="-1" containment="true" eType="#//Group"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="annotations" upperBound="-1" containment="true" eType="#//Annotation"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="FlowNode" abstract="true" eSuperTypes="#//NamedElement">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="enabled" defaultValueLiteral="true" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="StartNode" eSuperTypes="#//FlowNode"/>
  <eClassifiers xsi:type="ecore:EClass" name="EndNode" eSuperTypes="#//FlowNode"/>

  <eClassifiers xsi:type="ecore:EClass" name="Task" eSuperTypes="#//FlowNode">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="durationMinutes" defaultValueLiteral="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="progress" defaultValueLiteral="0" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="automated" defaultValueLiteral="false" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="ports" upperBound="-1" containment="true" eType="#//Port"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="DecisionNode" eSuperTypes="#//FlowNode">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="expression" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="DataStoreNode" eSuperTypes="#//FlowNode">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="kind" lowerBound="1" eType="#//DataStoreKind"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="Port" eSuperTypes="#//NamedElement">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="direction" lowerBound="1" eType="#//PortDirection"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="Connection" eSuperTypes="#//NamedElement">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="kind" lowerBound="1" eType="#//ConnectionKind"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="source" lowerBound="1" eType="#//FlowNode"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="target" lowerBound="1" eType="#//FlowNode"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="Group" eSuperTypes="#//NamedElement">
    <eStructuralFeatures xsi:type="ecore:EReference" name="members" upperBound="-1" eType="#//FlowNode"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="Annotation" eSuperTypes="#//NamedElement">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="text" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="target" eType="#//FlowNode"/>
  </eClassifiers>
</ecore:EPackage>
