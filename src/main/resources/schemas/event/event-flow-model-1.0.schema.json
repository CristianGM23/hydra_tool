{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hydra.local/schemas/event/event-flow-model-1.0.schema.json",
  "title": "HYDRA EventFlowModel 1.0",
  "type": "object",
  "required": ["schemaVersion", "id", "metamodelId", "flows"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "id": { "type": "string", "minLength": 1 },
    "metamodelId": { "type": "string", "minLength": 1 },
    "eventDefinitionModelId": { "type": "string" },
    "expressionModelId": { "type": "string" },
    "flows": { "type": "array", "items": { "$ref": "#/$defs/flow" } },
    "annotations": { "type": "object", "additionalProperties": { "type": "string" } }
  },
  "additionalProperties": false,
  "$defs": {
    "flow": {
      "type": "object",
      "required": ["id", "name", "enabled", "nodes", "transitions"],
      "properties": {
        "id": { "type": "string", "minLength": 1 }, "name": { "type": "string", "minLength": 1 }, "description": { "type": "string" }, "enabled": { "type": "boolean" },
        "triggerEventTypeIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "variables": { "type": "array", "items": { "type": "object", "required": ["id", "name", "type"], "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "type": { "type": "string" }, "initialValue": {} }, "additionalProperties": false } },
        "nodes": { "type": "array", "items": { "$ref": "#/$defs/node" }, "minItems": 1 },
        "transitions": { "type": "array", "items": { "$ref": "#/$defs/transition" } },
        "compensations": { "type": "array", "items": { "type": "object", "required": ["id", "sourceNodeId", "compensationNodeId"], "properties": { "id": { "type": "string" }, "sourceNodeId": { "type": "string" }, "compensationNodeId": { "type": "string" } }, "additionalProperties": false } },
        "annotations": { "type": "object", "additionalProperties": { "type": "string" } }
      }, "additionalProperties": false
    },
    "node": {
      "type": "object", "required": ["id", "name", "kind", "enabled"],
      "properties": {
        "id": { "type": "string" }, "name": { "type": "string" },
        "kind": { "enum": ["START","SUCCESS_END","ERROR_END","EVENT_STEP","COMMAND_STEP","ACTION_STEP","OPERATION_STEP","DECISION","MERGE","PARALLEL_SPLIT","JOIN","TIMEOUT","RETRY","WAIT_FOR_EVENT","MANUAL_STEP","COMPENSATION_STEP","FALLBACK","ERROR_HANDLER","SOURCE","FILTER","MAP","ROUTE","DEDUPLICATE","EMIT","WINDOW","AGGREGATE","SEQUENCE","PATTERN","ABSENCE"] },
        "referenceId": { "type": "string" }, "eventTypeId": { "type": "string" }, "conditionExpressionId": { "type": "string" }, "configuration": { "type": "object" },
        "retryPolicy": { "type": "object", "properties": { "maxAttempts": { "type": "integer", "minimum": 0 }, "delayMillis": { "type": "integer", "minimum": 0 }, "backoffMultiplier": { "type": "number", "exclusiveMinimum": 0 } }, "additionalProperties": false },
        "timeoutPolicy": { "type": "object", "properties": { "timeoutMillis": { "type": "integer", "minimum": 0 }, "timeoutTransitionId": { "type": "string" } }, "additionalProperties": false },
        "compensable": { "type": "boolean" }, "enabled": { "type": "boolean" }
      }, "additionalProperties": false
    },
    "transition": {
      "type": "object", "required": ["id", "sourceNodeId", "targetNodeId", "kind"],
      "properties": { "id": { "type": "string" }, "sourceNodeId": { "type": "string" }, "targetNodeId": { "type": "string" }, "kind": { "enum": ["NEXT","ON_SUCCESS","ON_ERROR","COMPENSATES","TIMEOUT","TRUE","FALSE"] }, "conditionExpressionId": { "type": "string" }, "order": { "type": "integer" }, "label": { "type": "string" } },
      "additionalProperties": false
    }
  }
}
