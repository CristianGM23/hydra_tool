{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hydra.local/schemas/gamification/gamification-definition-model-1.0.schema.json",
  "title": "HYDRA GamificationDefinitionModel 1.0",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "metamodelId",
    "name",
    "pointTypes",
    "levels",
    "achievements",
    "challenges",
    "rewards"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "id": {
      "type": "string"
    },
    "metamodelId": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "pointTypes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "minimumBalance": {
            "type": "integer"
          }
        },
        "additionalProperties": false
      }
    },
    "levels": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "pointTypeId",
          "minimumPoints"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "pointTypeId": {
            "type": "string"
          },
          "minimumPoints": {
            "type": "integer",
            "minimum": 0
          },
          "rewardId": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "achievements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "rewardId": {
            "type": "string"
          },
          "hidden": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "challenges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "targetCount"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "targetCount": {
            "type": "integer",
            "minimum": 1
          },
          "rewardId": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "rewards": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "payload": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    },
    "annotations": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
