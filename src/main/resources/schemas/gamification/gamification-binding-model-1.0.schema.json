{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hydra.local/schemas/gamification/gamification-binding-model-1.0.schema.json",
  "title": "HYDRA GamificationBindingModel 1.0",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "metamodelId",
    "definitionModelId",
    "rules"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "id": {
      "type": "string"
    },
    "metamodelId": {
      "type": "string"
    },
    "definitionModelId": {
      "type": "string"
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "eventTypeId",
          "points",
          "repeatPolicy",
          "enabled"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "eventTypeId": {
            "type": "string"
          },
          "conditionPath": {
            "type": "string"
          },
          "operator": {
            "type": "string"
          },
          "expectedValue": {},
          "pointsTypeId": {
            "type": "string"
          },
          "points": {
            "type": "integer"
          },
          "achievementId": {
            "type": "string"
          },
          "challengeId": {
            "type": "string"
          },
          "rewardId": {
            "type": "string"
          },
          "repeatPolicy": {
            "enum": [
              "ONCE",
              "ONCE_PER_EVENT",
              "UNLIMITED",
              "COOLDOWN",
              "DAILY_LIMIT"
            ]
          },
          "cooldownSeconds": {
            "type": "integer",
            "minimum": 0
          },
          "maxAwardsPerActor": {
            "type": "integer",
            "minimum": 0
          },
          "maxAwardsPerDay": {
            "type": "integer",
            "minimum": 0
          },
          "enabled": {
            "type": "boolean"
          },
          "effectKind": {
            "enum": [
              "AWARD",
              "PENALTY"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "annotations": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
