{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modeling-editor.local/schemas/validation-report-1.0.schema.json",
  "title": "ValidationReport 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "modelId",
    "metamodelId",
    "validationModelId",
    "generatedAt",
    "scope",
    "diagnostics",
    "metrics"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,239}$"
    },
    "modelId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,119}$"
    },
    "metamodelId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,119}$"
    },
    "validationModelId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,119}$"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    },
    "metrics": {
      "$ref": "#/$defs/metrics"
    },
    "planId": {
      "type": "string"
    },
    "mode": {
      "enum": [
        "FULL",
        "INCREMENTAL",
        "SELECTION",
        "CLASS",
        "MANUAL",
        "ON_OPEN",
        "ON_SAVE",
        "BEFORE_EXPORT"
      ]
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "completedAt": {
      "type": "string",
      "format": "date-time"
    },
    "executedRuleIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "skippedRuleIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "MODEL",
            "OBJECT",
            "FEATURE",
            "SELECTION",
            "RULE",
            "RULE_SET"
          ]
        },
        "elementId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,239}$"
        },
        "featureId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,239}$"
        },
        "ruleId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,239}$"
        },
        "ruleSetId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,239}$"
        }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "modelElementId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,239}$"
        },
        "featureId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,239}$"
        },
        "relationInstanceId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,239}$"
        }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "ruleId",
        "severity",
        "message",
        "quickFixIds"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,239}$"
        },
        "kind": {
          "enum": [
            "VIOLATION",
            "RULE_EXECUTION_ERROR",
            "BROKEN_RULE"
          ]
        },
        "ruleId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,239}$"
        },
        "severity": {
          "enum": [
            "ERROR",
            "WARNING",
            "INFO"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "location": {
          "$ref": "#/$defs/location"
        },
        "quickFixIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,239}$"
          },
          "uniqueItems": true
        },
        "details": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evaluatedRules",
        "skippedRules",
        "durationMillis"
      ],
      "properties": {
        "evaluatedRules": {
          "type": "integer",
          "minimum": 0
        },
        "skippedRules": {
          "type": "integer",
          "minimum": 0
        },
        "durationMillis": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
