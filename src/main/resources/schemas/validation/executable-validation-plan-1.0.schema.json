{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modeling-editor.local/schemas/executable-validation-plan-1.0.schema.json",
  "title": "ExecutableValidationPlan 1.0",
  "description": "Contrato interno y depurable. No es una fuente canónica editable.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "metamodelId",
    "metamodelEtag",
    "validationModelId",
    "validationModelEtag",
    "compiledRules"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "metamodelId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,119}$"
    },
    "metamodelEtag": {
      "type": "string"
    },
    "validationModelId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,119}$"
    },
    "validationModelEtag": {
      "type": "string"
    },
    "compiledRules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/compiledRule"
      }
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,239}$"
    },
    "expressionModelId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,119}$"
    },
    "actionModelId": {
      "type": "string"
    },
    "sourceFingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sourceVersions": {
      "type": "object"
    },
    "dependencyIndex": {
      "type": "object"
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "annotations": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "compiledRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ruleId",
        "contextKind",
        "severity",
        "triggerSet",
        "dependencyIds",
        "executable"
      ],
      "properties": {
        "ruleId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,239}$"
        },
        "contextKind": {
          "enum": [
            "CLASS",
            "ATTRIBUTE",
            "RELATION",
            "OBJECT",
            "MODEL",
            "REPRESENTATION",
            "SELECTION",
            "PROJECT"
          ]
        },
        "severity": {
          "enum": [
            "ERROR",
            "WARNING",
            "INFO"
          ]
        },
        "triggerSet": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "dependencyIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,239}$"
          },
          "uniqueItems": true
        },
        "executable": {
          "type": "boolean"
        },
        "compilationErrors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "name": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "context": {
          "type": "object"
        },
        "conditionExpressionId": {
          "type": "string"
        },
        "messageTemplate": {
          "type": "string"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "quickFixIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "executionMode": {
          "type": "string"
        },
        "ruleSetIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
