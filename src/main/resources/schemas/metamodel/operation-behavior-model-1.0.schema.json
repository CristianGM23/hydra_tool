{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/operation-behavior-model-1.0.schema.json",
  "title": "OperationBehaviorModel 1.0",
  "type": "object",
  "required": ["schemaVersion", "metamodelId", "bindings", "annotations"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "metamodelId": { "type": "string", "minLength": 1 },
    "bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["operationId", "implementationKind", "expressionId", "actionId", "externalReference", "annotations"],
        "properties": {
          "operationId": { "type": "string", "minLength": 1 },
          "implementationKind": { "enum": ["UNIMPLEMENTED", "EXPRESSION", "ACTION", "EXTERNAL"] },
          "expressionId": { "type": "string" },
          "actionId": { "type": "string" },
          "externalReference": { "type": "string" },
          "annotations": { "type": "object", "additionalProperties": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "annotations": { "type": "object", "additionalProperties": { "type": "string" } }
  },
  "additionalProperties": false
}
