{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hydra.local/schemas/portability/layer-interchange-envelope-1.0.schema.json",
  "title": "HYDRA Layer Interchange Envelope 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "metamodelId", "dependencies", "payload", "annotations"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "kind": {
      "type": "string",
      "enum": ["VALIDATION", "QUICK_FIX", "EVENTS", "EVENT_FLOW", "GAMIFICATION"]
    },
    "metamodelId": { "type": "string" },
    "dependencies": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "payload": {},
    "annotations": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    }
  }
}
