{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hydra.local/schemas/portability/hydra-capability-archive-descriptor-1.0.schema.json",
  "title": "HYDRA capability archive descriptor 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "packageId",
    "packageVersion",
    "contentHash",
    "signatureAlgorithm",
    "signatureKeyId",
    "signature",
    "entries",
    "annotations"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "packageId": {
      "type": "string",
      "minLength": 1
    },
    "packageVersion": {
      "type": "string"
    },
    "contentHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "signatureAlgorithm": {
      "type": "string"
    },
    "signatureKeyId": {
      "type": "string"
    },
    "signature": {
      "type": "string"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "size",
          "sha256",
          "kind"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "kind": {
            "type": "string"
          }
        }
      }
    },
    "annotations": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  }
}
