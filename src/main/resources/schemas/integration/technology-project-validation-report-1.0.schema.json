{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hydra.local/schemas/integration/technology-project-validation-report-1.0.schema.json",
  "title": "HYDRA TechnologyProjectValidationReport 1.0",
  "type": "object",
  "required": ["technology", "status", "steps", "metadata"],
  "properties": {
    "technology": {"type": "string"}, "status": {"enum": ["PASSED", "PARTIAL", "FAILED"]}, "workspaceDirectory": {"type": ["string", "null"]},
    "steps": {"type": "array", "items": {"type": "object", "required": ["id", "description", "status", "command", "durationMillis", "stdout", "stderr", "diagnostics"], "properties": {
      "id": {"type": "string", "minLength": 1}, "description": {"type": "string"}, "status": {"type": "string"}, "command": {"type": "array", "items": {"type": "string"}},
      "exitCode": {"type": ["integer", "null"]}, "durationMillis": {"type": "integer", "minimum": 0}, "stdout": {"type": "string"}, "stderr": {"type": "string"},
      "diagnostics": {"type": "array", "items": {"type": "string"}}
    }, "additionalProperties": false}},
    "metadata": {"type": "object", "additionalProperties": {"type": "string"}}
  }, "additionalProperties": false
}
