{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hydra.local/schemas/integration/round-trip-manifest-1.0.schema.json",
  "title": "HYDRA RoundTripManifest 1.0",
  "type": "object",
  "required": ["schemaVersion", "profileId", "technology", "generatorVersion", "createdAt", "mappings", "annotations"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "profileId": {"type": "string", "minLength": 1},
    "technology": {"type": "string"},
    "generatorVersion": {"type": "string"},
    "createdAt": {"type": "string", "format": "date-time"},
    "mappings": {"type": "array", "items": {"type": "object", "required": ["canonicalDocumentId", "artifactKind", "nativePath", "sourceElementIds", "generatedSha256", "ownership", "metadata"], "properties": {
      "canonicalDocumentId": {"type": "string", "minLength": 1}, "artifactKind": {"type": "string"}, "nativePath": {"type": "string", "minLength": 1},
      "sourceElementIds": {"type": "array", "items": {"type": "string"}}, "generatedSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
      "ownership": {"type": "string"}, "metadata": {"type": "object", "additionalProperties": {"type": "string"}}
    }, "additionalProperties": false}},
    "annotations": {"type": "object", "additionalProperties": {"type": "string"}}
  },
  "additionalProperties": false
}
