          "target": {
            "kind": "SELF"
          },
          "attributeId": "attribute:class:Book:pages",
          "value": {
            "literal": 1
          }
        }
      ],
      "transactionPolicy": "ATOMIC",
      "undoPolicy": "REQUIRED",
      "annotations": {}
    }
  ]
