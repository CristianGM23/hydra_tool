    {
      "path": "artifacts/contacts.metamodel.json",
      "kind": "METAMODEL",
      "required": true
    },
    {
      "path": "artifacts/people.model.json",
      "kind": "MODEL",
      "required": true
    },
    {
      "path": "artifacts/contacts.model.json",
      "kind": "MODEL",
      "required": true
    },
    {
      "path": "artifacts/people-contacts.transformation.json",
      "kind": "TRANSFORMATION",
      "required": true
    }
  ],
  "acceptance": [
    "all-json-parse",
    "metamodel-id-consistency",
    "bidirectional-rules-present",
    "incremental-policy-present",
    "no-secret-files"
