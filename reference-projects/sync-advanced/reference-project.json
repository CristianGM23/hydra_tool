{
  "schemaVersion": "1.0",
  "id": "sync-advanced",
  "level": "ADVANCED",
  "title": "Sincronización bidireccional People ↔ Contacts",
  "description": "Proyecto de referencia M2M bidireccional e incremental con dos metamodelos y modelos base.",
  "capabilities": [
    "METAMODEL",
    "MODEL",
    "TRANSFORMATION_M2M",
    "BIDIRECTIONAL_SYNC",
