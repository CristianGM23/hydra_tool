          "targetFeatureId": "attribute:class:Person:name",
          "kind": "DIRECT",
          "sourceFeatureId": "attribute:class:Contact:displayName",
          "literalValue": null,
          "expression": null,
          "valuePolicy": null,
          "annotations": {}
