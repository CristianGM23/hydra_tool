  "cards": [
    { "dot": "emerald", "title": "Architectural principles", "items": [
      "HYDRA's canonical model always uses the current schema; there are no migration chains before GA",
      "External formats are execution/export adapters, never dependencies of the canonical model",
      "Unknown project files are preserved as PROJECT_RESOURCE instead of being discarded",
      "HYDRA never executes imported project code during analysis"
    ]},
    { "dot": "cyan", "title": "Persistence & concurrency", "items": [
      "One JSON document per canonical artifact, with ETag optimistic concurrency (CanonicalDocumentStore)",
      "No database: everything lives on the local filesystem, under data/ (excluded from distribution packages)",
      "All ten capability services persist the same way; the diagram draws only the Publication edge as a representative",
      "Every canonical mutation is automatically observed to feed the audit log"
    ]},
    { "dot": "rose", "title": "Security", "items": [
      "HydraRequestHardeningFilter bounds the shape and size of every incoming HTTP request",
      "HydraExternalProcessRunner is the single launcher for external processes: minimal environment, bounded output, timeout and process-tree teardown",
      "Third-party MDE engines (ATL/ETL/Acceleo/EGL/Xtend) require explicit administrator installation; a missing engine fails closed rather than being simulated"
    ]},
    { "dot": "violet", "title": "Provenance of this diagram", "items": [
      "Repository: github.com/CristianGM23/hydra_tool · branch main · commit 864ed52",
      "Clean working tree (no local changes) at generation time",
      "Initial generation: no previous Archify architecture existed to compare against",
      "HYDRA version: 4.32.107 (config/hydra-version.json)"
    ]},
    { "dot": "slate", "title": "Out of scope for this diagram", "items": [
      "CI/CD (.github/workflows/hydra-ci.yml) and the release/qualification scripts are build infrastructure, not runtime architecture",
      "Build, CI and toolchain detail lives in docs/architecture/archify/README.md"
    ]}
  ]
